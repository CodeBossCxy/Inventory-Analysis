# Copy this file to ".env" and fill in real values.
# PLEX_AUTH = the Base64 string after "Basic " in your Power Query Authorization header.
PLEX_AUTH=your_base64_token_here

PLEX_HOST=https://Vintech.on.plex.com
PLEX_DATASOURCE_ID=18777
COMPANY_UTC_OFFSET=-5
PORT=3000

# Optional tuning (defaults shown) — only needed if the variability page is too
# slow or hits too many timeouts:
# VARIABILITY_CONCURRENCY=5     # parallel Plex calls during the catalog pull
# PLEX_TIMEOUT_MS=30000         # per-call timeout
# CURRENT_WEEK_TTL_MS=3600000   # how long the in-progress week stays cached (1h)
